/scratch
/scratch-shm
/scratch-wal

# Standalone simulated integration workbench
web/ui/dist-integrations/
# Local graph snapshots and profiling artifacts (may contain vault metadata).
web/ui/.profile-local/

# Local credentials and audit exports must never become publication inputs.
.env.*
!.env.example
.DS_Store
.tmp/
.publication-audit/

# Synthetic CI failure diagnostics.
/artifacts/
