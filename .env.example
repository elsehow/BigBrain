# Secrets — copied to .env on first run (bun bin/init.ts); .env is
# gitignored and never committed. Fill in only what you enable in
# vault.yaml; everything here stays commented until you need it.

# granola integration (vault.yaml: integrations.granola) — meeting
# transcripts via the Granola public API.
#GRANOLA_API_KEY=

# gardener auth — only when vault.yaml sets `auth: api`. The default
# (`auth: max`) uses your logged-in Claude subscription and needs no key.
#ANTHROPIC_API_KEY=

# the pilot (settings › vault › pilot) — a push-to-talk voice agent over the vault,
# on OpenAI's realtime model with YOUR key (a ChatGPT subscription does not
# cover it; platform.openai.com, with credits). The settings screen writes
# this line. The switch retains the key when voice is disabled.
#OPENAI_API_KEY=
#BIGBRAIN_PILOT_ENABLED=true

# ports — web viewer (default 4747) and intake api (default 4748). One knob
# each: a bare PORT= here would reach BOTH servers (every job gets this
# file's engine settings, never its keys) and pile them onto one port.
#BIGBRAIN_WEB_PORT=
#BIGBRAIN_API_PORT=
