{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main viewer served from the local engine",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "notification:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "allow-update-check",
    "allow-update-install",
    "allow-window-background",
    "allow-window-is-maximized",
    "allow-window-toggle-maximize",
    "allow-ui-diagnostic"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  }
}
