{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BigBrain",
  "version": "0.7.29",
  "identifier": "cool.bigbrain.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:4747",
    "devUrl": "http://127.0.0.1:4747",
    "beforeBuildCommand": "sh build-resources.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/bun"
    ],
    "resources": [
      "resources/engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQjYzNDdGQTlBQzMxQUUKUldTdU1heXBmelMya2xndHF1TEhJalZpanVlVFdudFBqU3BaaXl0Zm95RHpvcUhNL1hURWQ1MGYK",
      "endpoints": [
        "https://bigbrain.exe.xyz/latest.json"
      ]
    }
  }
}
